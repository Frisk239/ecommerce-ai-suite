# 复制为 .env 后按需修改（.env 已被 .gitignore 排除）
# compose.yaml 自带默认值，跑 compose 不依赖本文件。

DATABASE_URL=postgresql://suite:suite@localhost:5432/suite
STORAGE_ROOT=./data/objects

# 种子操作者（username=operator）密码：默认 operator123 仅开发用
OPERATOR_PASSWORD=operator123
# 会话 cookie 签名密钥：生产必换，换钥即全体会话失效
SESSION_SECRET=dev-insecure-session-secret

# 厂商 Chat Completions（ADR 0028/0033）。任意 OpenAI 兼容端点。
# 真实密钥只写本机 .env，禁止提交、禁止写进文档。
# 接通生成是独立刀；未配密钥时客服仍走证据组装模板。
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=qwen3.8-flash

# 云 ASR 转写（第 93 刀，ADR 0050）。OpenAI 兼容 POST {base}/audio/transcriptions，
# verbose_json 取句级时间戳；默认 Groq turbo（89 刀定案）。**空 key = 不建客户端、
# 不发请求**：切片页「自动转写」如实 409，人工填写转写与本地脚本兜底不受影响。
ASR_API_KEY=
ASR_BASE_URL=https://api.groq.com/openai/v1
ASR_MODEL=whisper-large-v3-turbo

# 云 VLM 看图出描述草稿（第 94a 刀，ADR 0051）。OpenAI 兼容 POST {base}/chat/completions，
# messages 带 image_url（data URL 内联 base64）；任意视觉端点可换 base。
# **空 key = 不建客户端、不发请求**：上传商品图不出草稿，人洗补写描述兜底
# （草稿未经人确认不进检索索引——人洗确认才生效）。
VLM_API_KEY=
VLM_BASE_URL=https://api.openai.com/v1
VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct

# 云文生图（第 98 刀，ADR 0055）。OpenAI 兼容 POST {base}/images/generations，
# response_format=b64_json 取图字节；默认硅基流动（有免费 FLUX 档）。**空 key =
# 不建客户端、不发请求**：素材任务的「生成配图」诚实跳过（任务详情如实标注，
# 纯文案套件照常可用——配图是增值项不是任务本体）。
IMGGEN_API_KEY=
IMGGEN_BASE_URL=https://api.siliconflow.cn/v1
IMGGEN_MODEL=Kwai-Kolors/Kolors

# 云 TTS 口播（第 98b 刀，ADR 0056）。OpenAI 兼容 POST {base}/audio/speech，
# {model, input, voice} -> 音频字节；默认硅基流动 CosyVoice2。**空 key = 不建
# 客户端、不发请求**：成片预览无音轨（with_tts=false，任务详情如实标注「TTS
# 未配置，预览无声」——口播是增值项不是成片本体）。voice 用厂商预置音色
# （数字人/声音克隆 Out，红线④）。
TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex

# 云 Embedding（第 105 刀，向量基础设施 A1）。OpenAI 兼容 POST {base}/embeddings，
# {model, input:[...]} -> data[].embedding；默认硅基流动 bge-m3（免费档，1024 维，
# 与迁移 0034 的 vector(1024) 列同维）。**空 key = 不建客户端、不发请求**：发布
# 照常（块落库、embedding 留 NULL），词法检索主路不受影响；存量块由
# scripts/realdata/backfill_embeddings.py 回填（幂等，只补 NULL 行）。
EMBED_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# 连接层 MCP Bearer（ADR 0032）。与操作者登录无关。空则 MCP 全部 401。
# 下面仅开发默认，生产必换。
MCP_BEARER_TOKEN=dev-mcp-bearer

# 顾客通道 XFF 信任模式。空/false（默认）=直连：限流 IP 口径只信 TCP 对端
# 地址，完全忽略 X-Forwarded-For；true=反代模式：信 XFF 第一跳，需反向代理
# 强制覆盖该头（README 顾客通道节）。
CUSTOMER_TRUST_PROXY=

# 顾客会话令牌 TTL（第 45 刀）。默认 24h；过期与无效同 401 同文案。
CUSTOMER_TOKEN_TTL_SECONDS=86400

# 可嵌入客服小组件的宿主白名单（第 45b 刀）：逗号分隔 origin，**空 = 未启用嵌入**。
# 生产填商家站点（如 https://shop.example.com）；本地演示宿主页是 web 自身来源。
WIDGET_ALLOWED_ORIGINS=

# 指标端点（第 47 刀）：/metrics 的独立 Bearer。**空 = 端点一律 401**（默认不裸奔）。
# Prometheus 不会登录，故不复用操作者 cookie；生产用长随机串并只在网内暴露。
METRICS_TOKEN=

# 日志级别（第 47 刀）：structlog JSON 输出到 stdout，默认 INFO。
LOG_LEVEL=INFO
