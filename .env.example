# 复制为 .env 后按需修改（.env 已被 .gitignore 排除）
# compose.yaml 自带默认值，跑 compose 不依赖本文件。

DATABASE_URL=postgresql://suite:suite@localhost:5432/suite
STORAGE_ROOT=./data/objects

# 种子操作者（username=operator）密码：默认 operator123 仅开发用
OPERATOR_PASSWORD=operator123
# 会话 cookie 签名密钥：生产必换，换钥即全体会话失效
SESSION_SECRET=dev-insecure-session-secret

# 本阶段不调模型，仅留位
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
